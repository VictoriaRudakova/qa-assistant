{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["qa-assistant"],
  "permissions": {
    "allow": [
      "mcp__qa-assistant__jira_get_story",
      "mcp__qa-assistant__jira_search_stories",
      "mcp__qa-assistant__submit_story_analysis",
      "mcp__qa-assistant__submit_test_cases",
      "mcp__qa-assistant__validate_test_cases",
      "mcp__qa-assistant__get_run",
      "mcp__qa-assistant__list_runs",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(uv run mypy:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(git push:*)"
    ]
  }
}

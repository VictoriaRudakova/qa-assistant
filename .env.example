# Copy to .env (git-ignored) and fill in. NEVER commit real values.
# Use a TEST Jira instance and a read-only account/token.

# --- Jira -------------------------------------------------------------------
JIRA_BASE_URL=https://your-test-instance.example.com
JIRA_EMAIL=qa-bot@example.com
JIRA_API_TOKEN=
# All Jira reads are restricted to this project.
JIRA_PROJECT_KEY=DEMO
# Custom field holding acceptance criteria, e.g. customfield_10042.
# Leave empty to extract acceptance criteria from the issue description.
JIRA_ACCEPTANCE_CRITERIA_FIELD=
# Optional: cloud | data_center (not required yet; email is not needed for data_center PATs).
JIRA_DEPLOYMENT=
JIRA_MAX_SEARCH_RESULTS=50
JIRA_TIMEOUT_SECONDS=30

# --- Xray -------------------------------------------------------------------
# JSON column mapping for the Xray Test Case Importer (see docs/features/story-to-xray-csv.md).
# Leave empty until the real mapping is provided; export_xray_csv then reports not_configured.
XRAY_CSV_MAPPING_FILE=

# --- App --------------------------------------------------------------------
QA_OUTPUT_DIR=output
QA_LOG_LEVEL=INFO

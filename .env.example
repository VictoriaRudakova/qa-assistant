# Copy to .env (git-ignored) and fill in. NEVER commit real values.
# Use a TEST Jira instance and a read-only account/token.

# --- Jira -------------------------------------------------------------------
JIRA_BASE_URL=https://your-test-instance.example.com
JIRA_EMAIL=qa-bot@example.com
JIRA_API_TOKEN=
# All Jira reads are restricted to this project.
JIRA_PROJECT_KEY=DEMO
# Custom field holding acceptance criteria, e.g. customfield_10042.
# Leave empty to extract acceptance criteria from the issue description.
JIRA_ACCEPTANCE_CRITERIA_FIELD=
# cloud | data_center. Optional for *.atlassian.net hosts (Cloud); required otherwise.
# Email is not needed for data_center personal access tokens.
JIRA_DEPLOYMENT=
JIRA_MAX_SEARCH_RESULTS=50
JIRA_TIMEOUT_SECONDS=30
# Only for the opt-in live smoke test (`uv run pytest -m live`): an issue in JIRA_PROJECT_KEY.
JIRA_LIVE_TEST_ISSUE=

# --- Xray -------------------------------------------------------------------
# JSON column mapping for the Xray Test Case Importer (see docs/features/story-to-xray-csv.md).
# Leave empty until the real mapping is provided; export_xray_csv then reports not_configured.
XRAY_CSV_MAPPING_FILE=
# Xray Cloud API key (Xray > Settings > API Keys), used read-only by get_xray_test.
# Reads are scoped to JIRA_PROJECT_KEY. Xray Server/Data Center is not supported.
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
# Global endpoint by default; data-residency tenants use their region, e.g.
# https://eu.xray.cloud.getxray.app (us / eu / au). Must be https.
XRAY_CLOUD_BASE_URL=https://xray.cloud.getxray.app
XRAY_TIMEOUT_SECONDS=30
# Only for the opt-in live smoke test: a Test issue key in JIRA_PROJECT_KEY.
XRAY_LIVE_TEST_ISSUE=

# --- App --------------------------------------------------------------------
QA_OUTPUT_DIR=output
QA_LOG_LEVEL=INFO
